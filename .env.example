# TestBrain 环境变量样例
#
# 使用方式：
#   cp .env.example .env
# 然后按下面各项说明填写。.env 位于项目根目录，config/settings.py 启动时自动加载。
# 请勿把填好真实密钥的 .env 提交到仓库。

# ============================================
# 1. 数据库（必填：MySQL 8.x）
# ============================================
# 需先手工创建库，例如：
#   CREATE DATABASE test_brain_db DEFAULT CHARACTER SET utf8mb4;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=test_brain_db

# ============================================
# 2. 大模型 API Key（AI 功能必填）
# ============================================
# 变量名规则：<provider 名称大写>_API_KEY，provider 取自 settings.py 的 LLM_PROVIDERS。
# 当前内置 deepseek / qwen 两个 provider，二者默认都走阿里云 DashScope 的兼容模式地址，
# 因此这里填 DashScope 控制台申请的同一个 Key 即可（https://bailian.console.aliyun.com/）。
# 不配置 Key 时项目仍可启动，但 AI 生成/评审类接口会报错。
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ============================================
# 3. 知识库（可选：Milvus + 嵌入模型）
# ============================================
# 默认关闭，项目可在没有 Milvus 的机器上直接启动。
# 需要知识库检索功能时改为 true，并准备好 Milvus 服务（见 README「可选依赖」）。
ENABLE_MILVUS=false
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DB=default
MILVUS_COLLECTION=vv_knowledge_collection

# 嵌入模型提供方：aliyun（阿里云 text-embedding-v4，默认）| local（本地 BGE-M3）
# 选 aliyun 时必须填 QWEN_API_KEY；选 local 时首次运行会自动下载 BAAI/bge-m3 模型。
EMBEDDING_PROVIDER=aliyun

# ============================================
# 4. Java 源码分析服务（可选：独立部署的外部服务）
# ============================================
# 该服务不在本仓库内，详见 README「可选依赖」；不部署时仅 java_code_analyzer 页面不可用。
JAVA_ANALYZER_SERVICE_URL=http://127.0.0.1:8089

# ============================================
# 5. 其他（可选）
# ============================================
# HuggingFace 下载镜像，默认已使用国内镜像 https://hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com

# 仅在使用 apps/ai_agents/java_code_analyzer 下的独立命令行脚本时需要
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat